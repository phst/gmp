bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")

gmp_repo = use_repo_rule("//:gmp_repo.bzl", "gmp_repo")

gmp_repo(
    name = "gmp",
    sha256 = "a3c2b80201b89e68616f4ad30bc66aee4927c3ce50e33929ca819d5c43538898",
    version = "6.3.0",
)

bazel_dep(
    name = "buildifier_prebuilt",
    version = "8.5.1.4",
    dev_dependency = True,
    repo_name = "buildifier",
)
bazel_dep(name = "rules_go", version = "0.63.0", dev_dependency = True)
bazel_dep(name = "gazelle", version = "0.54.0", dev_dependency = True)

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps", dev_dependency = True)
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_google_addlicense")

bazel_dep(
    name = "phst_update_workspace_snippets",
    version = "0",
    dev_dependency = True,
    repo_name = "update-workspace-snippets",
)
git_override(
    module_name = "phst_update_workspace_snippets",
    commit = "cd929f2a105c8f97954f90b7e026e1201fce7042",
    remote = "https://github.com/phst/update-workspace-snippets.git",
)
